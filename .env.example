# Copy to .env.local for local development. In Vercel: Project → Settings → Environment Variables.
# Without the Supabase variables the site runs in demo mode on sample data kept in memory.

# Public URL of the site (used for the QR poster and link previews)
NEXT_PUBLIC_SITE_URL=https://skvoznyaki.vercel.app

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Needed for votes and the shared rate limit. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Long random string. Used to hash IPs and device ids (nothing is stored in the clear).
# Generate: openssl rand -hex 32
HASH_SALT=

# Optional: Telegram notifications about every new entry
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Demo mode only (no Supabase): password for /admin. In local dev it defaults to "efir".
DEMO_ADMIN_PASSWORD=
